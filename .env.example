# Copy this file to .env and fill in the values. Never commit .env.

# Required. PostgreSQL connection string (Neon in the cloud, local Postgres in dev).
# If you do not know your local postgres password, run `pnpm db:local` to start a
# project-local cluster and use: postgresql://argus@localhost:5433/argus
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/argus

# Optional. Signs the demo session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Groq free tier, used only for drafting case summaries and letters.
# Leave empty to use the offline templates.
GROQ_API_KEY=
# Any chat model your Groq key lists (console.groq.com/docs/models). Checked October 2026.
LLM_MODEL=openai/gpt-oss-20b

# Optional. If set, /api/cron/tick requires the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
