{
  "name": "argus",
  "private": true,
  "description": "Argus: AICTE approval workflow, compliance monitoring and alert management prototype (SIH 2026, PS26262)",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:init": "node scripts/py.mjs scripts/db.py init",
    "db:seed": "node scripts/py.mjs scripts/db.py seed",
    "db:generate": "node scripts/py.mjs scripts/db.py generate",
    "db:reset": "node scripts/py.mjs scripts/db.py reset",
    "dev": "node scripts/dev.mjs check && concurrently -k -n api,web -c red,yellow \"node scripts/dev.mjs api\" \"node scripts/dev.mjs web\"",
    "dev:check": "node scripts/dev.mjs check",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:api:reload": "node scripts/dev.mjs api --reload",
    "dev:web": "node scripts/dev.mjs web",
    "build": "pnpm --dir frontend build",
    "test": "node scripts/py.mjs -m pytest -q",
    "lint": "node scripts/py.mjs -m ruff check backend scripts api",
    "smoke": "node scripts/py.mjs scripts/smoke.py",
    "screens": "node scripts/screens.mjs",
    "screens:roles": "node scripts/role-tour.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "playwright": "1.64.1"
  }
}
